{
  "name": "workfare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:offers": "vitest run --config src/app/app-home/offers/vitest.offers.config.ts",
    "test:demo": "node --test scripts/demo/contracts.test.mjs",
    "test:dependencies": "node --test scripts/dependency-compatibility.test.mjs",
    "test:all": "npm test && npm run test:offers && npm run test:demo && npm run test:dependencies",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "security:audit": "npm audit --package-lock-only --audit-level=low",
    "demo:setup": "node scripts/demo/setup.mjs",
    "demo:dev": "node scripts/demo/dev.mjs",
    "demo:cleanup": "node scripts/demo/cleanup.mjs"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.86.2",
    "@types/leaflet": "^1.9.21",
    "@types/uuid": "^10.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.26",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.555.0",
    "next": "^16.3.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-leaflet": "^5.0.0",
    "stripe": "^20.3.1",
    "tailwind-merge": "^3.4.0",
    "uuid": "^14.0.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.3.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "vite": "^6.4.3"
  }
}
