# Documentation only. Never copy actual credentials into Git or logs.
# The default enables neither payment setup nor money movement.
WORKFARE_PAY_MODE=disabled
APP_ORIGIN=http://localhost:3001

# LOCAL ONLY: local_simulation has no Stripe/card/bank input. Sandbox requires
# verified local demo isolation and individually enrolled synthetic identities.
# Put test credentials in private .env.demo.local, never production configuration.
STRIPE_SECRET_KEY=<PRIVATE_STRIPE_SERVER_KEY>
STRIPE_PUBLISHABLE_KEY=<STRIPE_PUBLISHABLE_KEY>
WORKFARE_PAY_RECIPIENT_SANDBOX=disabled
WORKFARE_PAY_ORDER_PREVIEW=disabled
WORKFARE_PAY_ORDER_SANDBOX=disabled
# Sandbox fees can use local-zero-fee-v1 or test-service-5-v1. The latter's tax
# snapshot is a test assumption, never a production tax determination.

# Four independently signed destinations; never use NEXT_PUBLIC_* names for
# server keys or signing secrets. Missing/wrong-mode configuration fails closed.
STRIPE_WEBHOOK_SECRET=<PRIVATE_BUYER_WEBHOOK_SECRET>
STRIPE_CONNECT_WEBHOOK_SECRET=<PRIVATE_CONNECT_THIN_WEBHOOK_SECRET>
STRIPE_CONNECT_SNAPSHOT_WEBHOOK_SECRET=<PRIVATE_CONNECT_SNAPSHOT_WEBHOOK_SECRET>
STRIPE_PAYMENT_WEBHOOK_SECRET=<PRIVATE_PAYMENT_WEBHOOK_SECRET>

# LIVE ONLY: configure these in the private production server environment.
# Requires WORKFARE_PAY_MODE=live, a restricted rk_live_ server key, pk_live_
# publishable key, no demo flags/references, canonical HTTPS app and Supabase
# origins, plus separately reviewed private DB configuration. No test rows are
# promoted. Applying migrations or setting a key does not enable payment gates.
# WORKFARE_PAY_LIVE_ENABLED=enabled
# APP_ORIGIN=https://app.workfa.re
# SUPABASE_URL=https://<VERIFIED_PRODUCTION_PROJECT>.supabase.co
# NEXT_PUBLIC_SUPABASE_URL=https://<VERIFIED_PRODUCTION_PROJECT>.supabase.co
# WORKFARE_PAY_LIVE_PROJECT_REF=<VERIFIED_PRODUCTION_PROJECT>
# WORKFARE_PAY_LIVE_PLATFORM_ACCOUNT=<VERIFIED_LIVE_PLATFORM_ACCOUNT>
# WORKFARE_PAY_LIVE_ORDERS=disabled
# WORKFARE_PAY_HOSTED_STATE_SECRET=<PRIVATE_RANDOM_32_BYTE_OR_LONGER_SECRET>
# Optional only after Stripe custom domain certificate is actually active:
# WORKFARE_PAY_CHECKOUT_ORIGIN=https://pay.workfa.re
# Live orders require workfare-service-5-v1: gross 5% extra to the agreed pay.
# No assumed VAT rate/net tax amount; processing costs reduce platform margin.
# Guardian onboarding start for ages14-17 is implemented with actual child DOB
# and current authenticated parent consent. Stripe must collect and verify the
# actual legal guardian and its agreement; country/account eligibility is not
# guaranteed. No minor readiness without fresh bound identity/guardian evidence.
# Live adults18-20 also require matching canonical Stripe identity.
# Stopping LIVE_ORDERS closes new quotes/authorizations; valid live maintenance,
# signed webhooks, existing capture/cancel/refund remain available.
# No wallet, discretionary holding, own manual-payout API or instant payouts.
# Publication/reservation gates stay independently disabled during setup rollout.
# See docs/operations/workfare-pay-production.md before enabling actual charges.
